        <mxCell id="sandbox-escape" value="沙箱逃逸" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="runtime-threats">
          <mxGeometry x="215" y="60" width="85" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="resource-exhaustion" value="资源耗尽 DoS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="runtime-threats">
          <mxGeometry x="70" y="120" width="180" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 攻击路径箭头 -->
        <mxCell id="arrow1" value="" style="endArrow=classic;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="prompt-injection" target="llm">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="400" y="450" as="sourcePoint"/>
            <mxPoint x="450" y="400" as="targetPoint"/>
