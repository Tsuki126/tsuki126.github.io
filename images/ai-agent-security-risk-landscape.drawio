<mxfile host="app.diagrams.net">
  <diagram id="ai-agent-security" name="AI Agent 安全风险全景">
    <mxGraphModel dx="800" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        
        <!-- 背景容器 -->
        <mxCell id="bg" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;opacity=30;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1120" height="820" as="geometry"/>
        </mxCell>
        
        <!-- 标题 -->
        <mxCell id="title" value="AI Agent 安全风险全景图" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontColor=#1a1a1a;" vertex="1" parent="1">
          <mxGeometry x="400" y="60" width="400" height="40" as="geometry"/>
        </mxCell>
        
        <!-- 中心：AI Agent 核心架构 -->
        <mxCell id="core-container" value="AI Agent 核心" style="swimlane;startSize=40;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="440" y="320" width="320" height="280" as="geometry"/>
        </mxCell>
        
        <mxCell id="llm" value="LLM 推理引擎" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="core-container">
          <mxGeometry x="20" y="60" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="memory" value="记忆系统" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="core-container">
          <mxGeometry x="180" y="60" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="tools" value="工具调用层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="core-container">
          <mxGeometry x="20" y="140" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="rag" value="RAG 知识库" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="core-container">
          <mxGeometry x="180" y="140" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <mxCell id="orchestrator" value="编排控制器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="core-container">
          <mxGeometry x="100" y="210" width="120" height="50" as="geometry"/>
        </mxCell>
        
        <!-- 左侧：输入层威胁 -->
        <mxCell id="input-threats" value="输入层威胁" style="swimlane;startSize=40;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="320" width="280" height="280" as="geometry"/>
        </mxCell>
        
        <mxCell id="prompt-injection" value="提示注入&#xa;Prompt Injection" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="input-threats">
          <mxGeometry x="20" y="60" width="240" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="jailbreak" value="越狱攻击&#xa;Jailbreak" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="input-threats">
          <mxGeometry x="20" y="120" width="240" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="data-poisoning" value="数据投毒&#xa;Data Poisoning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="input-threats">
          <mxGeometry x="20" y="180" width="240" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 右侧：输出层威胁 -->
        <mxCell id="output-threats" value="输出层威胁" style="swimlane;startSize=40;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="320" width="280" height="280" as="geometry"/>
        </mxCell>
        
        <mxCell id="data-leakage" value="数据泄露&#xa;Data Leakage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="output-threats">
          <mxGeometry x="20" y="60" width="240" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="hallucination" value="幻觉输出&#xa;Hallucination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="output-threats">
          <mxGeometry x="20" y="120" width="240" height="45" as="geometry"/>
        </mxCell>
        
        <mxCell id="harmful-content" value="有害内容生成&#xa;Harmful Content" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;fontStyle=1;" vertex="1" parent="output-threats">
          <mxGeometry x="20" y="180" width="240" height="45" as="geometry"/>
        </mxCell>
        
        <!-- 上方：基础设施层威胁 -->
